{
  "name": "relying-party-admin-tool",
  "version": "1.0.0",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "scripts": {
    "install-all": "npm ci && npm run install-submodules",
    "install-submodules": "git submodule update --init --recursive",
    "build-docker": "docker build -t relying-party-admin-tool-frontend .",
    "build-ts": "tsc",
    "build": "npm run build-sass && npm run build-ts && npm run copy-assets",
    "build-sass": "rm -rf dist/public/style.css && sass --load-path=node_modules/govuk-frontend/dist/govuk --no-source-map src/assets/scss/application.scss dist/public/style.css --style compressed",
    "copy-assets": "copyfiles -u 1 src/**/*.njk dist/ && npm run copy-scripts",
    "copy-scripts": "rm -r dist/public/scripts || true && mkdir -p dist/public/scripts && cp node_modules/govuk-frontend/dist/govuk/govuk-frontend.min.js dist/public/scripts",
    "coverage:unit": "vitest run --coverage",
    "dev": "npm run dynamodblocal:up && concurrently -k -p \"[{name}]\" -n \"Sass,TypeScript,Node\" -c \"yellow.bold,cyan.bold,green.bold\" \"npm run watch-sass\" \"npm run watch-ts\" \"npm run watch-node\"",
    "lint": "prettier . --check \"*/**/*.{ts,json}\" ; eslint . ",
    "lint:fix": "prettier . --write \"*/**/*.{ts,json}\" ; eslint . --fix",
    "start": "node dist/server.js",
    "test:unit": "vitest run",
    "tflint": "tflint --init && tflint --recursive --format compact --chdir infra",
    "tflint:fix": "tflint --init && tflint --recursive --format compact --chdir infra --fix",
    "watch-node": "nodemon -r dotenv/config --inspect=0.0.0.0:3000 dist/server.js",
    "watch-ts": "tsc -w",
    "watch-sass": "sass --load-path=node_modules/govuk-frontend/dist/govuk --watch src/assets/scss/application.scss dist/public/style.css",
    "dynamodblocal:up": "docker compose -f dynamodb.local.yml up -d",
    "dynamodblocal:down": "docker compose -f dynamodb.local.yml down"
  },
  "dependencies": {
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^10.0.1",
    "@govuk-one-login/frontend-vital-signs": "^0.1.4",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/eslint-plugin": "^1.6.18",
    "concurrently": "^10.0.3",
    "copyfiles": "^2.4.1",
    "dotenv": "^17.4.2",
    "eslint-plugin-playwright": "^2.10.4",
    "express": "~5.2.1",
    "govuk-frontend": "^6.1.0",
    "jiti": "^2.7.0",
    "nunjucks": "^3.2.4",
    "overload-protection": "^1.2.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prettier": "^3.8.3",
    "sass": "^1.100.0",
    "vitest": "^4.1.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.2",
    "@types/nunjucks": "^3.2.6",
    "@types/overload-protection": "^1.2.4",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}