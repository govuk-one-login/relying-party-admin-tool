{% extends "common/layout/base-layout.njk" %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}


{% set viewServiceUrl %}/services/{{ serviceId }}{% endset %}
{% set serviceName %}{{ serviceName }}{% endset %}

{% block pageContent %}
  <form class="form" action="{{ formAction }}" method="post">
    {{
      govukInput({
        label: {
          text: "What is the name of your client?",
          classes: "govuk-label--l",
          isPageHeading: true
        },
        hint: {
          text: "Your users will see this name when they sign in with GOV.UK One Login."
        },
        id: "name",
        name: "name",
        value: clientName,
        errorMessage: {
          text: errors["name"].text
        } if (errors["name"])
      })
    }}

    {{
      govukButton({
        text: "Continue"
      })
    }}
  </form>
{% endblock %}
