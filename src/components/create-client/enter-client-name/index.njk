{% extends "common/layout/base-layout.njk" %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}

{% set pageTitleName = "Enter client name" %}
{% set viewServiceUrl %}/services/{{ serviceId }}{% endset %}
{% set serviceName %}{{ serviceName }}{% endset %}

{% block beforeContent %}
  {{
    govukBreadcrumbs({
    items: [
      { text: "Your services", href: "/services" },
      { text: serviceName, href: viewServiceUrl },
      { text: "Create a client" } ] })
  }}
{% endblock %}

{% block pageContent %}
  <form class="form" action="enter-client-name" method="post">
    {{
      govukInput({
        label: {
          text: "What is the name of your client?",
          classes: "govuk-label--l",
          isPageHeading: true
        },
        hint: {
          text: "Your users will see this name when they sign in with GOV.UK One Login."
        },
        id: "name",
        name: "name",
        value: data['name'],
        errorMessage: {
          text: errors["name"].text
        } if (errors["name"])
      })
    }}

    {{
      govukButton({
        text: "Continue"
      })
    }}
  </form>
{% endblock %}
