{% extends "common/layout/base-layout.njk" %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageTitleName = 'Create a new integration client' %}
{% set viewServiceUrl %}/services/{{ serviceId }}{% endset %}

{% block beforeContent %}
  {{
    govukBreadcrumbs({
    items: [
      { text: "Your services", href: "/services" },
      { text: serviceName, href: viewServiceUrl },
      { text: "Create a client" } ] })
  }}
{% endblock %}

{% block pageContent %}
  <h1 class="govuk-heading-xl">Create a new integration client</h1>

  <p class="govuk-body">
    Use this service to create a configuration for your integration client. You
    will be able to create authentication-only or authentication and identity
    clients.
  </p>

  <p class="govuk-body">
    You can make changes to the information you submit in this journey if you
    need to.
  </p>

  <p class="govuk-body">Registering for a client takes around 5 minutes.</p>

  <h2 class="govuk-heading-l">Before you start</h2>

  <p class="govuk-body">You will need:</p>

  <ul class="govuk-list govuk-list--bullet">
    <li>client name</li>
    <li>
      either a JWKS endpoint url (recommended), public static key, or client
      secret
    </li>
    <li>redirect url(s)</li>
    <li>scopes your client requires</li>
  </ul>

  <p class="govuk-body">
    There may also be other fields that you will need to complete depending on
    whether you choose to add an identity configuration or any other additional
    configuration.
  </p>

  <p class="govuk-body">
    If you need further information, you can refer to the
    <a
      href="https://docs.sign-in.service.gov.uk/"
      class="govuk-link"
      rel="noreferrer noopener"
      target="_blank"
    >
      <span class="govuk-visually-hidden"> (opens in new tab) </span>
      technical documentation guidance (opens in a new tab)
    </a>
    , provided by GOV.UK One Login.
  </p>

  {{
    govukButton({
    text: "Start now",
    href: "enter-client-name",
    isStartButton: true
    })
  }}
{% endblock %}
