{% extends "common/layout/base-layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}

{% set pageTitleName = "Edit max age enabled" %}

{% block pageContent %}
  <form class="form" action="edit-max-age-enabled" method="post">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />

    {{
      govukRadios({
          name: "max-age-enabled",
          fieldset: {
            legend: {
              text: "Is max age enabled?",
              isPageHeading: true,
              classes: "govuk-fieldset__legend--l"
            }
          },
          items: [
            {
              value: "true",
              text: "Yes"
            },
            {
              value: "false",
              text: "No"
            }
          ],
        errorMessage: {
          attributes: { "data-test-id": "max-age-enabled-error"},
          text: errors["max-age-enabled"].text
        } if (errors["max-age-enabled"])
      })
    }}

    {{
      govukButton({
        text: "Confirm"
      })
    }}
  </form>
{% endblock %}
