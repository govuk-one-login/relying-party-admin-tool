{
  "name": "ui-tests",
  "version": "1.0.0",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "run-app": "cd ../../ && npm ci && npm run build && npm run start",
    "build": "docker build -t di-relying-party-admin-tool-frontend-ui-tests .",
    "install-browsers": "playwright install --with-deps chromium",
    "start-test-server": "npm run build && docker run --network=host --rm --init di-relying-party-admin-tool-frontend-ui-tests run-server",
    "watch": "nodemon -w ./tests -w ./utils -w ./.env.ts -w ./.env -e \"*\" --exec \"bddgen\"",
    "test": "npm ci && bddgen && playwright test",
    "test:ui": "npm ci && run-p test:ui:*",
    "test:ui:watch": "npm run watch",
    "test:ui:run": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.2.3",
    "playwright": "^1.58.2",
    "playwright-bdd": "^9.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1102.0",
    "@aws-sdk/lib-dynamodb": "^3.1118.0",
    "@axe-core/playwright": "^4.11.1",
    "dotenv": "^17.3.1",
    "npm-run-all": "^4.1.5",
    "valibot": "^1.4.2"
  }
}
