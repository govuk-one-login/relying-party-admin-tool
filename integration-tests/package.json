{
  "name": "integration-tests",
  "version": "1.0.0",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "run:frontend": "cd ../ && npm run dev",
    "build": "docker build -t relying-party-admin-tool-integration-test .",
    "install-browsers": "playwright install --with-deps chromium",
    "start-test-frontend": "npm run install-browsers && cd ../ && npm run build && docker run --network=host --rm --init relying-party-admin-tool-frontend",
    "test": "npm ci && bddgen && playwright test",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.2.3",
    "playwright": "^1.58.2",
    "playwright-bdd": "^9.0.0"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.1",
    "dotenv": "^17.3.1",
    "valibot": "^1.2.0"
  }
}
